{
  "name": "proyecto3-movies",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs db",
    "db:reset": "docker compose down -v && docker compose up -d",
    "front": "npm --prefix frontend start",
    "back": "npm --prefix backend start",
    "dev": "npm run db:up && concurrently \"npm run front\" \"npm run back\"",
    "dev:no-db": "concurrently \"npm run front\" \"npm run back\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
